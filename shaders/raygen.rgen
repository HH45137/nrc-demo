#version 460
#extension GL_EXT_ray_tracing : require

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 1, rgba8) uniform image2D outputImage;
layout(push_constant) uniform Camera {
    vec4 origin;
    vec4 right;
    vec4 up;
    vec4 forward;
} camera;
layout(location = 0) rayPayloadEXT vec3 radiance;

void main() {
    const vec2 size = vec2(gl_LaunchSizeEXT.xy);
    const vec2 pixel = (vec2(gl_LaunchIDEXT.xy) + 0.5) / size;
    const vec2 screen = vec2(pixel.x * 2.0 - 1.0, 1.0 - pixel.y * 2.0);
    const float aspect = size.x / size.y;
    const vec3 direction = normalize(camera.forward.xyz + screen.x * aspect * camera.right.xyz + screen.y * camera.up.xyz);
    radiance = vec3(0.0);
    traceRayEXT(topLevelAS, gl_RayFlagsOpaqueEXT, 0xff, 0, 0, 0,
                camera.origin.xyz, 0.001, direction, 10000.0, 0);
    imageStore(outputImage, ivec2(gl_LaunchIDEXT.xy), vec4(radiance, 1.0));
}
